# ═══════════════════════════════════════════════════════════════
# TradeNova SN — Environment Configuration Template
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

PORT=3000
SESSION_SECRET=your_super_secret_session_key_here

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tradenova
DB_PASSWORD=your_mysql_password
DB_NAME=tradenova

# Zerodha Kite Connect API v3 (Optional for live tick streaming)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://localhost:3000/api/kite/callback
